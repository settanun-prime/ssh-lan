<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH LAN - แผนผังเครือข่าย" Width="1380" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#0B0F17"
        FontFamily="Leelawadee UI, Segoe UI" FontSize="14" Foreground="#F4F7FB">
  <!-- the main window's styles are copied in here by topology-ui.ps1 -->
  <!--RESOURCES-->
  <Grid Margin="18,14,18,14">
    <Grid.Resources>
      <!-- compact controls for a tool surface: no trailing arrow, width from the label, icon + text -->
      <Style x:Key="MapTool" TargetType="Button">
        <Setter Property="Foreground" Value="#DCE3F0"/>
        <Setter Property="Background" Value="#151C2C"/>
        <Setter Property="BorderBrush" Value="#2A3348"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#1C2539"/><Setter TargetName="B" Property="BorderBrush" Value="#3A4560"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#111725"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MapPrimary" TargetType="Button" BasedOn="{StaticResource MapTool}">
        <Setter Property="Foreground" Value="#1A1405"/>
        <Setter Property="Background" Value="#F5C451"/>
        <Setter Property="BorderBrush" Value="#F5C451"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#FFD36B"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#E0AE3C"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- one half of the view switch; Tag="on" marks the active half -->
      <Style x:Key="MapSeg" TargetType="Button">
        <Setter Property="Foreground" Value="#A8B3C7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#1C2539"/></Trigger>
                <Trigger Property="Tag" Value="on"><Setter TargetName="B" Property="Background" Value="#2A3348"/><Setter Property="Foreground" Value="#F4F7FB"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MapIcon" TargetType="Button">
        <Setter Property="Foreground" Value="#8F9BB3"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="Transparent" CornerRadius="6">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2A3348"/><Setter Property="Foreground" Value="#F4F7FB"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MapLegend" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8F9BB3"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="6,0,14,0"/><Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- toolbar: one primary action, the view switch, then the quieter controls -->
    <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
      <Button x:Name="BtnMapScan" Style="{StaticResource MapPrimary}" Margin="0,0,10,6" ToolTip="สแกนวง LAN ใหม่ (ปกติรีเฟรชเองทุก 30 วินาที)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0"/>
          <TextBlock Text="สแกนใหม่" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Border Background="#121826" BorderBrush="#2A3348" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,10,6">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnMapLink" Style="{StaticResource MapSeg}" Content="ผังเส้นเชื่อม" ToolTip="เราเตอร์อยู่กลาง สายลงไปหาแต่ละเครื่อง"/>
          <Button x:Name="BtnMapGroup" Style="{StaticResource MapSeg}" Content="ผังกลุ่ม" ToolTip="ไทล์จัดกลุ่ม เหมาะกับเครื่องจำนวนมาก"/>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center">
        <TextBlock Text="จัดกลุ่มตาม" Foreground="#8F9BB3" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="MapGroupBy" Width="132" Height="34" VerticalContentAlignment="Center">
          <ComboBoxItem Content="วง IP" Tag="subnet" IsSelected="True"/>
          <ComboBoxItem Content="คำนำหน้าชื่อ" Tag="prefix"/>
          <ComboBoxItem Content="ชนิดเครื่อง" Tag="kind"/>
        </ComboBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
        <TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets" Foreground="#8F9BB3" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="ซูม (Ctrl + ล้อเมาส์)"/>
        <Slider x:Name="MapZoom" Width="96" Minimum="0.5" Maximum="1.6" Value="1" VerticalAlignment="Center"/>
      </StackPanel>
    </WrapPanel>

    <!-- status on its own quiet line, legend under it -->
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
      <TextBlock x:Name="MapStatus" Foreground="#A8B3C7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Line X1="0" Y1="6" X2="24" Y2="6" Stroke="#8F9BB3" StrokeThickness="2" VerticalAlignment="Center"/><TextBlock Text="สายแลน" Style="{StaticResource MapLegend}"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Line X1="0" Y1="6" X2="24" Y2="6" Stroke="#8F9BB3" StrokeThickness="2" StrokeDashArray="3,2" VerticalAlignment="Center"/><TextBlock Text="Wi-Fi" Style="{StaticResource MapLegend}"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Line X1="0" Y1="6" X2="24" Y2="6" Stroke="#8F9BB3" StrokeThickness="2" StrokeDashArray="1,3" Opacity="0.5" VerticalAlignment="Center"/><TextBlock Text="ไม่ทราบ" Style="{StaticResource MapLegend}"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Line X1="0" Y1="6" X2="24" Y2="6" Stroke="#4ADE80" StrokeThickness="2" StrokeDashArray="3,2" VerticalAlignment="Center"/><Polygon Points="7,4 0,0 0,8" Fill="#4ADE80" VerticalAlignment="Center" Margin="-2,0,0,0"/><TextBlock Text="SSH กับเครื่องนี้ (หัวลูกศร = ทางที่เข้าได้, 2 หัว = สองทาง)" Style="{StaticResource MapLegend}"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Line X1="0" Y1="6" X2="24" Y2="6" Stroke="#4ADE80" StrokeThickness="2" VerticalAlignment="Center"/><TextBlock Text="SSH เปิดอยู่ตอนนี้" Style="{StaticResource MapLegend}"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="TS" Foreground="#C4B5FD" FontWeight="Bold" FontSize="11" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="มี Tailscale (ไม่ใช่เข้าได้ทุกเครื่อง)" Style="{StaticResource MapLegend}"/></StackPanel>
      </WrapPanel>
      <!-- audit colours on a row of their own, so they never break mid-way after the line styles -->
      <WrapPanel>
        <TextBlock Text="ผล audit" Style="{StaticResource MapLegend}" Margin="0,0,8,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Ellipse Width="9" Height="9" Fill="#F87171" VerticalAlignment="Center"/><TextBlock Text="แก้ด่วน" Style="{StaticResource MapLegend}"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Ellipse Width="9" Height="9" Fill="#F5C451" VerticalAlignment="Center"/><TextBlock Text="ควรตรวจ" Style="{StaticResource MapLegend}"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Ellipse Width="9" Height="9" Fill="#4ADE80" VerticalAlignment="Center"/><TextBlock Text="ปลอดภัย" Style="{StaticResource MapLegend}"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Ellipse Width="9" Height="9" Fill="#8F9BB3" VerticalAlignment="Center"/><TextBlock Text="ยังไม่ได้ตรวจ" Style="{StaticResource MapLegend}"/></StackPanel>
      </WrapPanel>
    </StackPanel>

    <Border Grid.Row="2" Grid.Column="0" CornerRadius="12" BorderBrush="#1E2638" BorderThickness="1" Background="#0E121B" ClipToBounds="True">
      <Grid>
        <ScrollViewer x:Name="MapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas x:Name="MapCanvas" Width="1000" Height="600">
            <Canvas.LayoutTransform><ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform>
          </Canvas>
        </ScrollViewer>
        <TextBlock x:Name="MapEmpty" Text="ยังไม่พบเครื่อง กดสแกนใหม่" FontSize="16" Foreground="#6B7487" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </Border>

    <!-- the device record: identity first, facts in a fixed grid, actions at the bottom -->
    <Border x:Name="MapSide" Grid.Row="2" Grid.Column="1" Width="372" Margin="12,0,0,0" CornerRadius="12" Padding="0"
            Background="#111725" BorderBrush="#2A3348" BorderThickness="1" Visibility="Collapsed">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="18,16,10,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="10" Background="#1C2539" VerticalAlignment="Top" Margin="0,0,12,0">
            <TextBlock x:Name="SideGlyph" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#F5C451" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="SideTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <WrapPanel x:Name="SideChips" Margin="0,6,0,0"/>
          </StackPanel>
          <Button x:Name="BtnSideClose" Grid.Column="2" Style="{StaticResource MapIcon}" Content="&#xE711;" VerticalAlignment="Top" ToolTip="ปิดแผงนี้"/>
        </Grid>
        <Border DockPanel.Dock="Bottom" BorderBrush="#232C40" BorderThickness="0,1,0,0" Padding="18,12,18,14">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button x:Name="BtnSideSsh" Style="{StaticResource MapPrimary}" Content="เปิด SSH" ToolTip="เปิดหน้าต่าง SSH ไปที่เครื่องนี้"/>
              <Button x:Name="BtnSideAudit" Grid.Column="2" Style="{StaticResource MapTool}" Content="ตรวจความปลอดภัย"/>
            </Grid>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button x:Name="BtnSidePair" Style="{StaticResource MapTool}" Content="จับคู่กุญแจ" ToolTip="ใส่กุญแจของเครื่องนี้ลงเครื่องนั้น (ถามรหัสผ่านครั้งเดียวในหน้าต่างแยก)"/>
              <Button x:Name="BtnSideDiagnose" Grid.Column="2" Style="{StaticResource MapTool}" Content="ตรวจการเชื่อมต่อ" ToolTip="ไล่ตรวจทีละชั้น: ping, พอร์ต 22, แบนเนอร์, กุญแจ แล้วบอกวิธีแก้"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="ผู้ใช้" Foreground="#8F9BB3" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="SideUser" Grid.Column="1" Height="32" VerticalContentAlignment="Center" ToolTip="ชื่อผู้ใช้บนเครื่องนั้น ใช้ตอนเปิด SSH / จับคู่ / ตรวจ"/>
              <TextBlock Grid.Column="2" Text="ชนิด" Foreground="#8F9BB3" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0"/>
              <ComboBox x:Name="SideKind" Grid.Column="3" Height="32" VerticalContentAlignment="Center" ToolTip="แก้ชนิดเครื่องเอง ค่าที่ตั้งเองชนะหลักฐานเสมอ"/>
            </Grid>
            <Button x:Name="BtnSideTs" Style="{StaticResource MapTool}" Content="จับคู่ Tailscale…" Margin="0,8,0,0"
                    ToolTip="ผูกกล่อง LAN นี้กับเครื่องใน Tailscale (เมื่อ peer ไม่ประกาศ LAN IP). ถ้า SSH/audit ได้อยู่แล้วใช้ hostname จริงเป็นหลัก"/>
          </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,12,8">
          <StackPanel x:Name="SideBody"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>

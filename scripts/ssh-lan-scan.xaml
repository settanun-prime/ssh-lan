<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH LAN - เครื่องในวง LAN" Width="1320" Height="720" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#0E121B"
        FontFamily="Leelawadee UI, Segoe UI" FontSize="14" Foreground="#F4F7FB">
  <!-- the main window's styles are copied in here by scan-ui.ps1 -->
  <!--RESOURCES-->
  <Grid Margin="18,14,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
      <TextBlock Text="ช่วง IP" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="RangeBox" Width="230" Height="38" Margin="0,0,8,0"
               ToolTip="เว้นว่าง = ทุกวงที่เครื่องนี้ต่ออยู่ (สายแลนและ Wi-Fi) หรือพิมพ์ 192.168.1.0/24, 192.168.1.1-254"/>
      <Button x:Name="BtnScan" Style="{StaticResource PrimaryButton}" Content="สแกน" Width="120" Margin="0,0,8,0"/>
      <Button x:Name="BtnExport" Content="บันทึก CSV" Width="120" Margin="0,0,8,0"/>
      <Button x:Name="BtnAudit" Content="ตรวจความปลอดภัย" Margin="0,0,12,0"
              ToolTip="ดูว่าแต่ละเครื่องเปิดพอร์ตอะไร ใครเข้าได้ และเข้าจากอินเทอร์เน็ตได้ไหม (อ่านอย่างเดียว ไม่เปลี่ยนอะไร)"/>
      <TextBlock x:Name="ScanStatus" Foreground="#A8B3C7" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>

    <DataGrid x:Name="HostGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
              Background="#0A0D14" RowBackground="#121826" AlternatingRowBackground="#0F1420"
              Foreground="#F4F7FB" BorderBrush="#2A3348" BorderThickness="1"
              HorizontalGridLinesBrush="#1E2638" RowHeight="30">
      <DataGrid.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2C3858"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
      </DataGrid.Resources>
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="#151C2C"/>
          <Setter Property="Foreground" Value="#8F9BB3"/>
          <Setter Property="FontSize" Value="12"/>
          <Setter Property="Padding" Value="8,6"/>
          <Setter Property="BorderBrush" Value="#2A3348"/>
          <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="8,0"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="28" MinWidth="28">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><Ellipse Width="9" Height="9" Fill="{Binding Dot}"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="ชื่อเครื่อง" Binding="{Binding Name}" Width="150" MinWidth="120"/>
        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120" MinWidth="110"/>
        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150" MinWidth="140"/>
        <DataGridTextColumn Header="ระบบ" Binding="{Binding Os}" Width="110" MinWidth="80"/>
        <DataGridTextColumn Header="บริการที่เปิด" Binding="{Binding Services}" Width="*" MinWidth="200"/>
        <DataGridTextColumn Header="จับคู่แล้ว (ssh)" Binding="{Binding Alias}" Width="130" MinWidth="110"/>
        <DataGridTextColumn Header="หมายเหตุ" Binding="{Binding Note}" Width="120" MinWidth="100"/>
        <DataGridTextColumn Header="หลักฐาน" Binding="{Binding Evidence}" Width="260" MinWidth="200"/>
      </DataGrid.Columns>
    </DataGrid>

    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Text="ผู้ใช้" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBox x:Name="UserBox" Width="130" Height="38" Margin="0,0,8,6" ToolTip="ชื่อผู้ใช้บนเครื่องที่เลือก (ใช้ตอน SSH และจับคู่)"/>
      <Button x:Name="BtnSsh" Content="เปิด SSH" Margin="0,0,6,6"/>
      <Button x:Name="BtnDiagnose" Content="ตรวจว่าทำไมเข้าไม่ได้" Margin="0,0,6,6"
              ToolTip="ไล่ตรวจทีละชั้น: ping, พอร์ต 22, แบนเนอร์, กุญแจ แล้วบอกวิธีแก้ของชั้นที่ติด"/>
      <Button x:Name="BtnPairHost" Content="จับคู่" Margin="0,0,6,6"/>
      <CheckBox x:Name="BothBox" Content="สองทาง" Foreground="#C5CEDD" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,6" IsChecked="True"/>
      <Button x:Name="BtnRdp" Content="Remote Desktop" Margin="0,0,6,6"/>
      <Button x:Name="BtnWeb" Content="เปิดเว็บ" Margin="0,0,6,6"/>
      <Button x:Name="BtnShare" Content="เปิดไฟล์แชร์" Margin="0,0,6,6"/>
      <Button x:Name="BtnWake" Content="ปลุกเครื่อง (WOL)" Margin="0,0,6,6"/>
      <Button x:Name="BtnCopy" Content="คัดลอก IP" Margin="0,0,6,6"/>
    </WrapPanel>

    <DockPanel Grid.Row="3" Margin="0,4,0,0" LastChildFill="True">
      <Button x:Name="BtnShutdown" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="ปิดเครื่อง" Margin="6,0,0,0"/>
      <Button x:Name="BtnRestart" DockPanel.Dock="Right" Content="รีสตาร์ท" Margin="6,0,0,0"/>
      <Button x:Name="BtnRun" DockPanel.Dock="Right" Content="รันคำสั่ง" Margin="6,0,0,0"/>
      <TextBox x:Name="CmdBox" Height="38" ToolTip="คำสั่งที่จะรันบนเครื่องที่เลือกผ่าน SSH (ต้องจับคู่ก่อน) เช่น hostname, ipconfig, df -h"/>
    </DockPanel>

    <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
      <Button x:Name="BtnDiscover" DockPanel.Dock="Left" Content="ให้เครื่องนี้มองเห็นในวง LAN" Margin="0,0,12,0"
              ToolTip="ตั้งเครือข่ายเป็น Private, เปิด Network Discovery, แชร์ไฟล์ และ ping เฉพาะวง LAN (ต้องเป็นผู้ดูแล)"/>
      <Button x:Name="BtnInvite" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="เชิญเครื่อง" Margin="0,0,6,0"
              ToolTip="เปิดลิงก์เชิญ 15 นาที: เครื่องใหม่ในวง LAN/Tailscale เปิดลิงก์แล้วติดตั้งและจับคู่เอง (ต้องเป็นผู้ดูแล)"/>
      <Button x:Name="BtnInvitePkg" DockPanel.Dock="Left" Content="สร้างชุดติดตั้ง USB" Margin="0,0,8,0"
              ToolTip="โฟลเดอร์ติดตั้งสำหรับเครื่องที่ยังไม่อยู่วงเดียวกัน: คัดลอกไปแล้วดับเบิลคลิก join.cmd"/>
      <CheckBox x:Name="InviteTs" DockPanel.Dock="Left" Content="ลง Tailscale ด้วย" Foreground="#C5CEDD" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <CheckBox x:Name="InviteKeyOnly" DockPanel.Dock="Left" Content="ใช้กุญแจอย่างเดียว (ปิดรหัสผ่าน)" Foreground="#C5CEDD" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                ToolTip="ไม่ติ๊ก = เครื่องที่เข้าวงยังเข้าด้วยรหัสผ่านได้เหมือนเดิม ติ๊ก = ปิดรหัสผ่านหลังทดสอบกุญแจผ่าน"/>
      <TextBlock x:Name="ScanLog" Foreground="#C5CEDD" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>

    <Border x:Name="InvitePanel" Grid.Row="5" Visibility="Collapsed" Margin="0,10,0,0" Padding="14,10" CornerRadius="10"
            BorderBrush="#F5C451" BorderThickness="1" Background="#151C2C">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="รหัสยืนยัน" Style="{StaticResource StatLabel}" HorizontalAlignment="Center"/>
          <TextBlock x:Name="InviteCode" FontSize="28" FontWeight="Bold" Foreground="#F5C451" HorizontalAlignment="Center" FontFamily="Consolas"/>
          <TextBlock x:Name="InviteLeft" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" Margin="0,2,0,6"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnCopyInvite" Content="คัดลอกลิงก์" Margin="0,0,6,0"/>
            <Button x:Name="BtnStopInvite" Style="{StaticResource DangerButton}" Content="หยุดเชิญ"/>
          </StackPanel>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="เครื่อง Windows: เปิดลิงก์นี้ ดาวน์โหลดแล้วดับเบิลคลิก join.cmd" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
          <TextBox x:Name="InviteUrl" IsReadOnly="True" Margin="0,0,0,8" FontFamily="Consolas"/>
          <TextBlock Text="Linux / macOS: วางคำสั่งนี้ใน Terminal" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
          <TextBox x:Name="InviteSh" IsReadOnly="True" FontFamily="Consolas"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>

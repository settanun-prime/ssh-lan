      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
          </Border.RenderTransform>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="#F4F7FB"/>
          </Trigger>
          <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
            <BeginStoryboard HandoffBehavior="Compose">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.1"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
            <BeginStoryboard HandoffBehavior="Compose">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="Background" Value="#181E2C"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#3D4E78"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#2A3A5C"/>
          <Setter Property="Foreground" Value="#F5C451"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="Background" Value="#1E2638"/>
      <Setter Property="BorderBrush" Value="#3D4E78"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Name="ToggleButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Focusable="False"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Name="Border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#A8B3C7" Data="M 0 0 L 4 4 L 8 0 Z"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Border" Property="BorderBrush" Value="#F5C451"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="12,0,32,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
              <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border Name="DropDownBorder" Background="#181E2C" BorderBrush="#3D4E78" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                      <StackPanel IsItemsHost="True"/>
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Border x:Name="Bar" Margin="2,0" CornerRadius="3" Background="#34405F"/>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#F5C451"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="CaretBrush" Value="#F5C451"/>
      <Setter Property="SelectionBrush" Value="#3D4E78"/>
      <Setter Property="Background" Value="#1E2638"/>
      <Setter Property="BorderBrush" Value="#3D4E78"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="10">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#6B7FB0"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#F5C451"/></Trigger>
          <Trigger Property="Tag" Value="invalid"><Setter TargetName="Frame" Property="BorderBrush" Value="#F87171"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="StatCard" TargetType="Border">
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2A3348"/>
      <Setter Property="Background"><Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#1C2438" Offset="0"/>
          <GradientStop Color="#141A28" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8F9BB3"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F4F7FB"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <TextBlock x:Name="StrRoleServer" Visibility="Collapsed" Text="เครื่องรับ SSH"/>
    <TextBlock x:Name="StrRoleClient" Visibility="Collapsed" Text="เครื่องที่ใช้เชื่อมต่อ"/>
    <TextBlock x:Name="StrHarden" Visibility="Collapsed" Text="เปิดรับ SSH"/>
    <TextBlock x:Name="StrClient" Visibility="Collapsed" Text="ตั้งเครื่องนี้ให้เชื่อมต่อ"/>
    <TextBlock x:Name="StrNoSshd" Visibility="Collapsed" Text="ยังไม่ติดตั้ง"/>
    <TextBlock x:Name="StrReady" Visibility="Collapsed" Text="พร้อมใช้งาน"/>
    <TextBlock x:Name="StrRefreshed" Visibility="Collapsed" Text="อัปเดตสถานะแล้ว"/>
    <TextBlock x:Name="StrNeedAdmin" Visibility="Collapsed" Text="กดปุ่มเปิดใหม่แบบผู้ดูแลก่อน"/>
    <TextBlock x:Name="StrNoExe" Visibility="Collapsed" Text="ไม่พบไฟล์โปรแกรม"/>
    <TextBlock x:Name="StrNoSsh" Visibility="Collapsed" Text="ไม่พบโปรแกรม ssh"/>
    <TextBlock x:Name="StrAskRemove" Visibility="Collapsed" Text="ปิดการรับ SSH บนเครื่องนี้หรือไม่"/>

    <Border x:Name="MainCard" Margin="10" CornerRadius="16" BorderBrush="#2A3348" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#151C2C" Offset="0"/>
          <GradientStop Color="#0E121B" Offset="0.55"/>
          <GradientStop Color="#0B0E15" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.RenderTransform>
        <TranslateTransform x:Name="CardRise" Y="18"/>
      </Border.RenderTransform>
      <Grid ClipToBounds="True">
        <!-- soft ambient glow, slowly breathing -->
        <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-300,150,0"
                 IsHitTestVisible="False" Opacity="0.6">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#33F5C451" Offset="0"/>
              <GradientStop Color="#00F5C451" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:4.5">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Ellipse.Triggers>
        </Ellipse>
        <Ellipse Width="460" Height="460" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-190,0,0,-250"
                 IsHitTestVisible="False" Opacity="1">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#2A4C7DFF" Offset="0"/>
              <GradientStop Color="#004C7DFF" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:5.5">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Ellipse.Triggers>
        </Ellipse>

        <Grid Margin="22,16,22,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal">
              <Image x:Name="Logo" Width="40" Height="40" Margin="0,0,12,0">
                <Image.Effect><DropShadowEffect Color="#F5C451" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/></Image.Effect>
              </Image>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="SSH LAN" FontSize="22" FontWeight="Bold" Foreground="#F5C451"/>
                  <TextBlock x:Name="VersionText" Foreground="#8F9BB3" FontSize="11" Margin="8,0,0,4" VerticalAlignment="Bottom"/>
                </StackPanel>
                <TextBlock Text="จัดการ SSH ในบ้าน จากหน้าต่างนี้" Foreground="#A8B3C7" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="AdminBadge" Text="" Foreground="#F5C451" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
              <Button x:Name="Minimize" Style="{StaticResource TitleButton}" Content="−"/>
              <Button x:Name="CloseWindow" Style="{StaticResource TitleButton}" Content="×"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource StatCard}">
              <StackPanel>
                <TextBlock Text="เครื่องนี้" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="RoleLine" Text="..." Style="{StaticResource StatValue}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="5,0" Style="{StaticResource StatCard}">
              <StackPanel>
                <TextBlock Text="เลข IP ในบ้าน" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="IpLine" Text="..." Style="{StaticResource StatValue}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="5,0,0,0" Style="{StaticResource StatCard}">
              <StackPanel>
                <TextBlock Text="บริการ SSH" Style="{StaticResource StatLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Grid Width="14" Height="14" Margin="0,2,9,0" VerticalAlignment="Center">
                    <Ellipse x:Name="SvcRing" Fill="#6B7487" Opacity="0" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale" ScaleX="0.6" ScaleY="0.6"/></Ellipse.RenderTransform>
                      <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" From="0.6" To="2.2" Duration="0:0:1.8"/>
                              <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" From="0.6" To="2.2" Duration="0:0:1.8"/>
                              <DoubleAnimation Storyboard.TargetName="SvcRing" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.8"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse x:Name="SvcDot" Width="8" Height="8" Fill="#6B7487"/>
                  </Grid>
                  <TextBlock x:Name="SvcLine" Text="..." FontSize="18" FontWeight="SemiBold" Foreground="#F4F7FB"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="250"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="LeftPanel" Margin="0,0,6,0">
                <TextBlock x:Name="SubnetLabel" Text="อนุญาตให้เข้าจาก" Style="{StaticResource StatLabel}" Margin="0,0,0,6"/>
                <ComboBox x:Name="SubnetBox" Height="38" Margin="0,0,0,10"/>
                <Button x:Name="BtnPrimary" Style="{StaticResource PrimaryButton}" Content="เปิดรับ SSH" Margin="0,0,0,6"/>
                <Button x:Name="BtnTest" Content="ทดสอบการเชื่อมต่อ" Margin="0,0,0,6"/>
                <Button x:Name="BtnAddClient" Content="เพิ่มกุญแจเครื่องอื่น" Margin="0,0,0,6"/>
                <Button x:Name="BtnRefresh" Content="อัปเดตสถานะ" Margin="0,0,0,6"/>
                <StackPanel x:Name="IpPanel">
                  <TextBlock Text="เลข IP คงที่ของเครื่องนี้" Style="{StaticResource StatLabel}" Margin="0,6,0,6"
                             ToolTip="พิมพ์เลขเต็ม เช่น 192.0.2.50 หรือพิมพ์เฉพาะตัวท้าย เช่น 50"/>
                  <TextBox x:Name="StaticIpBox" Margin="0,0,0,6" ToolTip="พิมพ์เลขเต็ม เช่น 192.0.2.50 หรือพิมพ์เฉพาะตัวท้าย เช่น 50"/>
                  <Button x:Name="BtnStaticIp" Content="ตั้งเลข IP คงที่" Margin="0,0,0,6"/>
                  <Button x:Name="BtnDhcp" Content="คืนเป็น IP อัตโนมัติ" Margin="0,0,0,6"/>
                </StackPanel>
                <StackPanel x:Name="PairPanel">
                  <TextBlock Text="จับคู่กับเครื่องอื่น (ผู้ใช้@IP)" Style="{StaticResource StatLabel}" Margin="0,6,0,6"/>
                  <TextBox x:Name="PairBox" Margin="0,0,0,6" ToolTip="เช่น user@192.0.2.20 หรือเว้นว่างแล้วกดปุ่มเพื่อสแกนหาเครื่องที่เปิดรับ SSH"/>
                  <CheckBox x:Name="PairBoth" Content="ให้เครื่องนั้นเข้ามาหาเครื่องนี้ด้วย" Foreground="#C5CEDD" FontSize="12" Margin="2,0,0,8"/>
                  <Button x:Name="BtnPair" Content="จับคู่เครื่อง" Margin="0,0,0,6"/>
                </StackPanel>
                <Button x:Name="BtnAdmin" Content="เปิดใหม่แบบผู้ดูแล" Margin="0,0,0,6"/>
                <Button x:Name="BtnRemove" Style="{StaticResource DangerButton}" Content="ปิดการรับ SSH"/>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" CornerRadius="12" Background="#0A0D14" BorderBrush="#2A3348" BorderThickness="1" Padding="14,12,6,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ผลลัพธ์" Style="{StaticResource StatLabel}"/>
                <!-- slim bar that sweeps while a task is running -->
                <Border x:Name="BusyBar" Grid.Row="1" Height="2" Margin="0,8,8,8" CornerRadius="1" ClipToBounds="True"
                        Background="#1B2336" Visibility="Hidden">
                  <Border Width="140" HorizontalAlignment="Left" CornerRadius="1">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00F5C451" Offset="0"/>
                        <GradientStop Color="#F5C451" Offset="0.5"/>
                        <GradientStop Color="#00F5C451" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform><TranslateTransform x:Name="BusySlide" X="-140"/></Border.RenderTransform>
                    <Border.Triggers>
                      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="BusySlide" Storyboard.TargetProperty="X" From="-140" To="760" Duration="0:0:1.3">
                              <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </Border.Triggers>
                  </Border>
                </Border>
                <ScrollViewer x:Name="LogScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="LogList" Margin="0,0,8,0"/>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <TextBlock Grid.Row="3" x:Name="Footer" Foreground="#8B95A8" FontSize="11" Margin="0,10,0,0"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH LAN - ตรวจความปลอดภัย" Width="1360" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#0E121B"
        FontFamily="Leelawadee UI, Segoe UI" FontSize="14" Foreground="#F4F7FB">
  <!-- the main window's styles are copied in here by audit-ui.ps1 -->
  <!--RESOURCES-->
  <Grid Margin="18,14,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
      <Button x:Name="BtnAuditRun" Style="{StaticResource PrimaryButton}" Content="ตรวจอีกครั้ง" Width="140" Margin="0,0,8,0"/>
      <Button x:Name="BtnAuditProbe" Content="ทดสอบจากข้างนอก (exit node)" Margin="0,0,8,0" IsEnabled="False"
              ToolTip="ส่งทราฟฟิกออกทางมือถือ Android ใน Tailscale ชั่วคราว แล้วเคาะ IP สาธารณะของบ้านดูว่าพอร์ตไหนเข้าจากนอกบ้านได้ ตั้งค่า exit node คืนเสมอ"/>
      <Button x:Name="BtnAuditFolder" Content="เปิดโฟลเดอร์ผล" Margin="0,0,8,0"/>
      <Button x:Name="BtnAuditFixAll" Content="ปิดทุกพอร์ตที่เสี่ยง (0)" Margin="0,0,12,0" IsEnabled="False"/>
      <TextBlock x:Name="AuditStatus" Foreground="#A8B3C7" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Text="ตรวจแบบอ่านอย่างเดียว · ปุ่มในคอลัมน์ สั่ง จะเปลี่ยนเครื่องจริง ทุกครั้งถามก่อนและย้อนได้"/>
    </DockPanel>

    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
      <Border Margin="0,0,8,0" Padding="14,8" CornerRadius="10" Background="#151C2C" BorderBrush="#F87171" BorderThickness="1">
        <StackPanel><TextBlock Text="แดง: แก้ทันที" Style="{StaticResource StatLabel}"/><TextBlock x:Name="SumRed" Text="-" FontSize="26" FontWeight="Bold" Foreground="#F87171"/></StackPanel>
      </Border>
      <Border Margin="0,0,8,0" Padding="14,8" CornerRadius="10" Background="#151C2C" BorderBrush="#F5C451" BorderThickness="1">
        <StackPanel><TextBlock Text="เหลือง: ตรวจว่าตั้งใจเปิด" Style="{StaticResource StatLabel}"/><TextBlock x:Name="SumAmber" Text="-" FontSize="26" FontWeight="Bold" Foreground="#F5C451"/></StackPanel>
      </Border>
      <Border Margin="0,0,8,0" Padding="14,8" CornerRadius="10" Background="#151C2C" BorderBrush="#4ADE80" BorderThickness="1">
        <StackPanel><TextBlock Text="เขียว: ปลอดภัย" Style="{StaticResource StatLabel}"/><TextBlock x:Name="SumGreen" Text="-" FontSize="26" FontWeight="Bold" Foreground="#4ADE80"/></StackPanel>
      </Border>
      <Border Padding="14,8" CornerRadius="10" Background="#151C2C" BorderBrush="#8F9BB3" BorderThickness="1">
        <StackPanel><TextBlock Text="เทา: ตรวจไม่ได้ / ไม่ทราบ" Style="{StaticResource StatLabel}"/><TextBlock x:Name="SumGray" Text="-" FontSize="26" FontWeight="Bold" Foreground="#8F9BB3"/></StackPanel>
      </Border>
    </UniformGrid>

    <Border Grid.Row="2" Margin="0,0,0,10" Padding="14,8" CornerRadius="10" Background="#151C2C" BorderBrush="#2A3348" BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="InternetLine" Text="อินเทอร์เน็ต: -" FontWeight="SemiBold"/>
        <TextBlock x:Name="InternetEvidence" Foreground="#A8B3C7" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <DataGrid x:Name="FindingGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
              Background="#0A0D14" RowBackground="#121826" AlternatingRowBackground="#0F1420"
              Foreground="#F4F7FB" BorderBrush="#2A3348" BorderThickness="1"
              HorizontalGridLinesBrush="#1E2638" RowHeight="30" HorizontalScrollBarVisibility="Auto">
      <DataGrid.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2C3858"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
      </DataGrid.Resources>
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="#151C2C"/>
          <Setter Property="Foreground" Value="#8F9BB3"/>
          <Setter Property="FontSize" Value="12"/>
          <Setter Property="Padding" Value="8,6"/>
          <Setter Property="BorderBrush" Value="#2A3348"/>
          <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="8,0"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="ToolTip" Value="{Binding Tip}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="28" MinWidth="28">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><Ellipse Width="11" Height="11" Fill="{Binding Dot}"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="ใหม่" Binding="{Binding New}" Width="50" MinWidth="50"/>
        <DataGridTextColumn Header="เครื่อง" Binding="{Binding Machine}" Width="120" MinWidth="100"/>
        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="115" MinWidth="110"/>
        <DataGridTextColumn Header="พอร์ต" Binding="{Binding PortText}" Width="70" MinWidth="70"/>
        <DataGridTemplateColumn Header="สั่ง" Width="140" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Background="Transparent" ToolTip="{Binding SwitchTip}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SwitchAction}" Value="none">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Button Content="{Binding SwitchLabel}" IsEnabled="{Binding SwitchEnabled}"
                        ToolTip="{Binding SwitchTip}" ToolTipService.ShowOnDisabled="True"
                        Padding="8,2" FontSize="12" Margin="0,2" MaxWidth="128"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="บริการ" Binding="{Binding Service}" Width="110" MinWidth="90"/>
        <DataGridTextColumn Header="โปรเซส" Binding="{Binding Process}" Width="120" MinWidth="100"/>
        <DataGridTextColumn Header="เปิดให้" Binding="{Binding OpenTo}" Width="100" MinWidth="90"/>
        <DataGridTextColumn Header="เหตุผล" Binding="{Binding Reason}" Width="260" MinWidth="200"/>
        <DataGridTextColumn Header="หลักฐาน" Binding="{Binding Evidence}" Width="230" MinWidth="180"/>
        <DataGridTextColumn Header="วิธีแก้" Binding="{Binding Fix}" Width="230" MinWidth="180"/>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="#8F9BB3" FontSize="12" TextWrapping="Wrap"
               Text="แดงกดปิดได้เมื่อปุ่มสั่งเปิดอยู่ · ปุ่มจาง = อ่านทูลทิปว่าทำไมปิดไม่ได้ · เหลือง = ตรวจว่าตั้งใจเปิด (แอปไม่ปิดให้) · เลื่อนซ้ายขวาที่แถบล่างของตาราง · ป้าย ใหม่ = ไม่มีในรอบก่อน"/>
  </Grid>
</Window>
